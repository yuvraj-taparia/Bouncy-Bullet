[gd_scene format=3]

[ext_resource type="Script" path="res://ui/game_menu.gd" id="1_menu"]
[ext_resource type="FontFile" path="res://ui/fonts/Silkscreen-Regular.ttf" id="2_font"]

[sub_resource type="StyleBoxFlat" id="StyleBox_back"]
content_margin_left = 14.0
content_margin_right = 14.0
bg_color = Color(0.23, 0.165, 0.15, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 5
border_color = Color(0.1, 0.11, 0.17, 1)
anti_aliasing = false

[sub_resource type="StyleBoxFlat" id="StyleBox_back_hover"]
content_margin_left = 14.0
content_margin_right = 14.0
bg_color = Color(0.42, 0.29, 0.23, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 5
border_color = Color(0.1, 0.11, 0.17, 1)
anti_aliasing = false

[sub_resource type="Theme" id="Theme_menu"]
default_font = ExtResource("2_font")
default_font_size = 18
Label/colors/font_color = Color(0.99, 0.96, 0.83, 1)
Button/colors/font_color = Color(1, 0.82, 0.25, 1)
Button/colors/font_hover_color = Color(1, 0.9, 0.5, 1)
Button/styles/normal = SubResource("StyleBox_back")
Button/styles/hover = SubResource("StyleBox_back_hover")
Button/styles/pressed = SubResource("StyleBox_back")
Button/styles/focus = SubResource("StyleBox_back_hover")

[node name="Main" type="Node"]
script = ExtResource("1_menu")

[node name="UI" type="Control" parent="."]
texture_filter = 1
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = SubResource("Theme_menu")

[node name="MenuHud" type="CanvasLayer" parent="."]
layer = 2

[node name="Back" type="Button" parent="MenuHud"]
unique_name_in_owner = true
visible = false
offset_left = 184.0
offset_top = 12.0
offset_right = 290.0
offset_bottom = 46.0
mouse_default_cursor_shape = 2
theme = SubResource("Theme_menu")
text = "MENU"

[connection signal="pressed" from="MenuHud/Back" to="." method="_return_to_menu"]
